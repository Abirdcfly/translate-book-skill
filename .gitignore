# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Pipeline working directories — regenerated by the scripts, never commit them.
# Anchored to the repo root so a project subdirectory can still use these names.
/work/
/units/
/batches/
/done/
/trans/
/staged/
/translated_prev/

# Source books and translations: do not commit a copyrighted book or its output.
# Add a negation (e.g. `!samples/tiny.epub`) if you really want a test fixture.
*.epub
*.pdf

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp
